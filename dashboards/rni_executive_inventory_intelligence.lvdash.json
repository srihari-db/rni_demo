{
  "datasets": [
    {
      "name": "ds_metrics",
      "displayName": "Metrics",
      "queryLines": [
        "SELECT region, customer_name, product_category, product_name, inventory_value,\n              potential_excess_exposure_value, potential_excess_value, pending_request_exposure_value, near_expiry_value,\n              returned_value, avoidable_logistics_cost_12m, requests_requiring_review\n            FROM rni_demo.gold.inventory_value_metrics"
      ]
    },
    {
      "name": "ds_exposure",
      "displayName": "Exposure",
      "queryLines": [
        "SELECT region, customer_name, product_category, product_name, bucket, value\n            FROM rni_demo.gold.inventory_exposure_current\n            LATERAL VIEW stack(3, 'Excess above PAR', excess_value, 'Approaching expiry (<=90d)', near_expiry_value,\n                               'Healthy', healthy_value) b AS bucket, value"
      ]
    },
    {
      "name": "ds_monthly",
      "displayName": "Monthly",
      "queryLines": [
        "SELECT month, region, customer_name, product_category, product_name, series, value\n            FROM rni_demo.gold.consumption_vs_shipments_monthly\n            LATERAL VIEW stack(2, 'Shipped to sites (movement)', shipped_value, 'Consumed at sites (utilization)', consumed_value) s AS series, value"
      ]
    },
    {
      "name": "ds_returns",
      "displayName": "Returns",
      "queryLines": [
        "SELECT return_month, region, customer_name, product_category, product_name, returned_value,\n              return_logistics_cost,\n              CASE WHEN potentially_avoidable THEN 'Over-allocation (potentially avoidable)' ELSE 'Short-dated / other' END AS return_type\n            FROM rni_demo.gold.returns_detail WHERE in_last_12_months"
      ]
    },
    {
      "name": "ds_top10",
      "displayName": "Top10",
      "queryLines": [
        "SELECT customer_name, region, SUM(potential_excess_value) AS excess_on_hand,\n              SUM(pending_request_exposure_value) AS pending_request_exposure,\n              SUM(potential_excess_exposure_value) AS potential_excess_exposure\n            FROM rni_demo.gold.inventory_value_metrics GROUP BY customer_name, region\n            ORDER BY potential_excess_exposure DESC LIMIT 10"
      ]
    },
    {
      "name": "ds_expiry",
      "displayName": "Expiry",
      "queryLines": [
        "SELECT region, customer_name, product_category, product_name,\n              CONCAT(CAST(expiry_horizon_order AS STRING), '. ', expiry_horizon) AS expiry_horizon, inventory_value\n            FROM rni_demo.gold.expiry_risk_horizon"
      ]
    },
    {
      "name": "ds_queue",
      "displayName": "Queue",
      "queryLines": [
        "SELECT review_priority, customer_name, region, product_category, product_name, requested_qty, recommended_qty,\n              on_hand_qty, par_level, consumed_last_120d, risk_category, potential_exposure_value, review_reason\n            FROM rni_demo.gold.shipment_review_queue WHERE human_review_required"
      ]
    }
  ],
